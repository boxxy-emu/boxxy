+/*
+ * Android has no resolv.conf, and an app cannot read the system's resolver
+ * settings from native code.  The embedding app passes the upstream DNS
+ * server for the guest's virtual nameserver in SLIRP_DNS ("a.b.c.d"; only
+ * the first of a comma-separated list is used).  Read on every lookup, so
+ * the app can change it while running.
+ */
+int get_dns_addr(struct in_addr *pdns_addr)
+{
+    const char *env = getenv("SLIRP_DNS");
+    char buf[INET_ADDRSTRLEN];
+    size_t n;
+
+    if (!env || !*env) {
+        return -1;
+    }
+    n = strcspn(env, ",");
+    if (n >= sizeof(buf)) {
+        return -1;
+    }
+    memcpy(buf, env, n);
+    buf[n] = '\0';
+    return inet_pton(AF_INET, buf, pdns_addr) == 1 ? 0 : -1;
+}
