[wrap-git]
url = https://gitlab.freedesktop.org/slirp/libslirp.git
revision = 26be815b86e8d49add8c9a8b320239b9594ff03d
# Android: upstream DNS from SLIRP_DNS (no resolv.conf); SLIRP_DNS_REDIRECT sends
# the guest's UDP DNS queries to a resolver the app runs
diff_files = slirp/android-dns.patch

[provide]
slirp = libslirp_dep
